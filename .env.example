# Django 核心設定
SECRET_KEY=django-insecure-portal-fwm-unified-gateway-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=https://www.alittlewonder.com
DATA_DIR=/app/data
USE_SQLITE=False

# 資料庫連線設定 (PostgreSQL)
DB_ENGINE=postgresql
DB_NAME=alw_portal
DB_USER=portal_user
DB_PASSWORD=portal_pass_secure_2026
DB_HOST=host.docker.internal
DB_PORT=5432

# Google OAuth 2.0 憑證 (由 Google Cloud Console 取得，免綁信用卡)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8081/accounts/google/callback/

# Django 超級管理員預設帳號 (容器首次啟動時將自動建立)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=adminpassword

